   "source": [
    "# https://leetcode.com/problems/find-the-highest-altitude/?envType=study-plan-v2&envId=leetcode-75\n",
    "def largestAltitude(gain: List[int]) -> int:\n",
    "    max = 0\n",
    "    cumul = 0\n",
    "    for i in range(len(gain)):\n",
    "        cumul+=gain[i]\n",
    "        if cumul>max:\n",
    "            max=cumul\n",
    "    return max"
   ]
  }
